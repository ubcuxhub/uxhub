# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# Square
NEXT_PUBLIC_SQUARE_APP_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_ENV=sandbox

# Square Webhooks
# - Run `ngrok http 3000` and replace YOUR_PUBLIC_URL below with the ngrok forwarding URL
# - Go to the Square Developer Console and, under "Webhooks/Subscriptions",
#   register a new webhook subscription with your ngrok URL.
#   Take note of the webhook signature key and replace the value below.
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=https://YOUR-PUBLIC-URL/api/square/webhook
# - When the app answers on more than one hostname, register a subscription per
#   hostname and list them here instead. Square signs each delivery with that
#   subscription's own key, so the URL and key must stay paired:
#   SQUARE_WEBHOOK_ENDPOINTS=https://a.example/api/square/webhook|key-a,https://b.example/api/square/webhook|key-b
SQUARE_WEBHOOK_ENDPOINTS=

# Resend
RESEND_API_KEY=
# Quote this value in a dotenv file, but paste it WITHOUT quotes into a hosting
# provider's environment variable field, or the quotes become part of the address.
EMAIL_FROM="UX Hub <noreply@ubcuxhub.ca>"

# Check-in QR codes (src/lib/check-in-token.ts)
# Signs ticket QR codes. Generate with `openssl rand -base64 32`. Changing it
# invalidates every ticket already issued, screenshots included.
CHECK_IN_TOKEN_SECRET=

# Seed prod target only (`pnpm seed --target=prod`, see scripts/seed/README.md).
# Never prefix these with NEXT_PUBLIC_: the dev server reads this file too.
SEED_PROD_SUPABASE_URL=
SEED_PROD_SUPABASE_SECRET_KEY=

# Feature flags (src/lib/flags.ts)
# Both default to ON locally and on preview deploys, and OFF in production.
NEXT_PUBLIC_FEATURE_STUDENT_EVENTS=
NEXT_PUBLIC_FEATURE_DARK_MODE=

# Sentry (src/lib/sentry.ts)
# Leave the DSN empty to keep error reporting off locally. Vercel sets these for
# production and preview; the auth token is only needed to upload source maps.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
