{
  "name": "uxhub",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.6.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "psql \"${SUPABASE_DB_URL:-postgresql://postgres:postgres@127.0.0.1:15432/postgres}\" -v ON_ERROR_STOP=1 -f supabase/tests/rls.sql",
    "test:integration": "node scripts/test-integration.ts",
    "email:templates": "node scripts/build-auth-templates.ts",
    "payment-smoke": "node --env-file=.env.local scripts/payment-smoke/index.ts",
    "seed": "node --env-file=.env.local scripts/seed/index.ts",
    "types:supabase": "supabase gen types typescript --project-id otsvpvnoqwlenghobdal --schema public > src/lib/supabase/database.types.ts",
    "supabase:local": "chmod +x \"supabase/reset-local.sh\" && ./supabase/reset-local.sh"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.4.0",
    "@square/web-sdk": "^2.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0",
    "resend": "^6.32.1",
    "square": "^46.0.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^30.1.2",
    "supabase": "^2.120.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6",
    "vitest": "^4.1.10"
  }
}
